{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LingoNote default capabilities",
  "windows": ["note", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "autostart:default",
    "dialog:default"
  ]
}
